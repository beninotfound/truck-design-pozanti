# Bu dosyayı ".env" olarak kopyalayın ve kendi değerlerinizi girin.
# .env dosyasını ASLA paylaşmayın veya git'e eklemeyin.

# Uzun, rastgele ve gizli bir anahtar (örn: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=buraya-uzun-ve-rastgele-bir-anahtar-yazin

# "production" veya "development"
FLASK_ENV=production

# WhatsApp numarası (ülke kodu ile, başında + olmadan)
WHATSAPP_NUMBER=905xxxxxxxxx
